# Build artifacts
/bin/
*.exe
*.test
*.out

# Project-local Go caches (GOCACHE=$PWD/.gocache, GOMODCACHE=$PWD/.gomodcache)
/.gocache/
/.gomodcache/
# Project-local Helm caches (HELM_CACHE_HOME=$PWD/.helmcache, ...) for sandboxes
# whose $HOME is read-only
/.helmcache/
/.helmconfig/
/.helmdata/
.gopath/
.worktrees/
.tools/

# Local logs and OS/IDE noise
*.log
.DS_Store
.idea/
.vscode/

# Local env files with credentials
.env
.env.*

# Generated archify visual-check evidence (docs/diagrams)
/docs/diagrams/*.visual-check.*
